# ---------------------------------------------------------------------------
# The Heritage Circle - environment variables
#
# Copy this file to `.env.local` and fill in the values from your own Sanity
# project. Never commit `.env.local` or any real credentials.
#
#   npm run seed      # creates the demo content in the dataset
#   npm run dev       # starts the website + Studio at http://localhost:3000
# ---------------------------------------------------------------------------

# --- Required: public Sanity project configuration -------------------------
# Find these with `npx sanity projects list` or in manage.sanity.io.
NEXT_PUBLIC_SANITY_PROJECT_ID="ws42qk2s"
NEXT_PUBLIC_SANITY_DATASET="production"

# Optional. Date used by the Sanity content lake API for schema/behaviour
# compatibility. Defaults to 2025-02-19 when unset.
NEXT_PUBLIC_SANITY_API_VERSION="2025-02-19"

# --- Optional: private datasets / draft preview ----------------------------
# Only needed when the dataset is NOT publicly readable, or when you want to
# read draft documents. This token stays server-side; it is never exposed to
# the browser (note the missing NEXT_PUBLIC_ prefix).
# Create a read-only token in manage.sanity.io -> API -> Tokens.
SANITY_API_READ_TOKEN=""

# --- Optional: write token used only by `npm run seed` --------------------
# Requires Editor (write) permissions. Used by scripts/seed.mts.
# Without it the site still runs; only the seed script is unavailable.
SANITY_API_WRITE_TOKEN=""

# --- Optional: on-demand revalidation webhook -----------------------------
# Shared secret that Sanity sends with the revalidation webhook request.
# Generate one with: node -e "console.log(crypto.randomUUID())"
SANITY_REVALIDATE_SECRET=""
